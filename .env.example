# 图书馆座位预约系统（libseat.scau.edu.cn）
# 复制成 .env 后填写。.env 已被 .gitignore 覆盖，不会入库。

LIBSEAT_USER=
LIBSEAT_PASS=

# 登录方式：cas = 统一身份认证（免验证码，推荐，密码就是门户密码）
#           local = 站点自带的账号密码（每次登录都要图形验证码）
LIBSEAT_LOGIN_MODE=cas

# 站点地址（一般不用改）
LIBSEAT_BASE_URL=https://libseat.scau.edu.cn

# 验证码求解方式：command | http | manual | none
#   command  本地命令，{file} 会被替换成图片路径，stdout 输出 4 位码（推荐，自建 OCR 走这条）
#   http     本地/远端服务，POST {"image_base64": "..."}，返回 {"code":"abcd"} 或纯文本
#   manual   只抓图不解码，由人/模型读图后把码传给 libseat_login
#   none     同 manual，语义上表示“不接求解器”
# 现成可用的基线（uv 会自动挑兼容的 Python，首次会下载依赖）：
LIBSEAT_CAPTCHA_MODE=command
LIBSEAT_CAPTCHA_CMD=uv run --python 3.12 --with ddddocr python <本目录绝对路径>/solvers/ddddocr_cli.py {file}
LIBSEAT_CAPTCHA_HTTP_URL=
LIBSEAT_CAPTCHA_HTTP_TOKEN=

# 验证码样本目录（相对本目录），manifest.jsonl 记录每张图的 JSESSIONID 与判定结果
LIBSEAT_CAPTCHA_DIR=captcha-samples

# 登录重试次数：每次重试都会换新会话 + 新验证码
LIBSEAT_LOGIN_RETRIES=5

# 探针账号：只用来判断“求解器给出的验证码是否被服务端接受”。可留空。
# 留空时 --probe 会退回用主账号（反正验证码对不上时根本走不到密码校验）。
LIBSEAT_PROBE_USER=
LIBSEAT_PROBE_PASS=

LIBSEAT_HTTP_TIMEOUT_MS=20000
